{
  "extends": "../tsconfig.web.json",
  "include": ["../src/renderer/src/env.d.ts", "../src/renderer/*.d.ts", "../src/types/*", "./**/*.ts", "./**/*.vue"],
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@renderer/routers": ["./router.ts"],
      "@renderer/utils/pages": ["./navigation.ts"],
      "@renderer/*": ["../src/renderer/src/*"],
      "@types/*": ["../src/types/*"]
    }
  }
}
